{
  "name": "playweb",
  "version": "1.0.0",
  "description": "For browser E2E testing",
  "main": "index.js",
  "scripts": {
    "test-firefox": "test",
    "test-firefox": "npx playwright test --project firefox --headed",
    "test-firefox-headless": "npx playwright test --project firefox",
    "test-chrome": "npx playwright test --headed",
    "test-chrome-headless": "npx playwright test --project \"Google Chrome\"",
    "test-edge": "npx playwright test --project \"Microsoft Edge\" --headed",
    "test-edge-headless": "npx playwright test --project \"Microsoft Edge\"",
    "test-chromium": "npx playwright test --project chromium --headed",
    "test-chromium-headless": "npx playwright test --project chromium",
    "test-webkit": "npx playwright test --project webkit --headed",
    "test-webkit-headless": "npx playwright test --project webkit",
    "debug-ui": "npx playwright test --project \"Google Chrome\" --ui"
  },
  "keywords": [
    "Playwright",
    "Web",
    "E2E"
  ],
  "author": "Abhishek",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@playwright/test": "^1.54.1",
    "@types/node": "^20.11.5",
    "eslint": "^9.31.0",
    "globals": "^16.3.0",
    "typescript-eslint": "^8.38.0"
  },
  "dependencies": {
    "dotenv": "^16.3.2",
    "playwright": "^1.43.0"
  }
}
